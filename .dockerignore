# Never accidentally package credentials, test caches or GCS binaries in cloud image.
.git
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
cloud/secrets/
cloud/.env
cloud/.env.*
!cloud/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
bin/
obj/
build-logs/
ExtLibs/
Plugins/
plugins/
resources/
