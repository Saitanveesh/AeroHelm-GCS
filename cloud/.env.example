# Cloud API, separate from Mission Planner/GCS binaries.
# Explicitly configure every non-example value in a secret manager.
AEROHELM_CLOUD_MODE=production
# Database URI must be injected using an isolated deployment secret file.
AEROHELM_DATABASE_URL_FILE=/run/secrets/app_database_url
AEROHELM_OIDC_ISSUER=https://idp.example.invalid/realms/aerohelm
AEROHELM_OIDC_JWKS_URL=https://idp.example.invalid/realms/aerohelm/protocol/openid-connect/certs
AEROHELM_OIDC_AUDIENCE=aerohelm-cloud
# FALSE until SITL/virtual adapter and backend authorization are validated.
AEROHELM_VIRTUAL_DISPATCH_ENABLED=false
# NEVER set AEROHELM_TEST_JWT_SECRET in production.
